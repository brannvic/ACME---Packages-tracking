    {
      "name": "4 - Contacto y decisión del proveedor",
      "description": "Ejecutar una sola vez cuando la guía ya esté en sucursal. Registrar la decisión cierra el caso y bloquea ediciones posteriores.",
      "item": [
        {
          "name": "Registrar contacto sin respuesta",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdministrador}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/paquetes/{{guiaReintentos}}/caso",
            "description": "Resultado esperado: HTTP 200.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteRespondio\": false,\n  \"notasContacto\": \"Se llamó al cliente, no hubo respuesta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Contacto registrado, caso aún abierto', function () { pm.expect(pm.response.json().contactoEn).to.be.a('string'); pm.expect(pm.response.json().casoCerradoEn).to.eql(null); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Registrar decisión del proveedor y cerrar el caso",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
