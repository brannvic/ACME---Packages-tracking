{
  "info": {
    "_postman_id": "0cc889fb-afe4-49b8-811a-d24c4a603064",
    "name": "ACME - 02 Reintentos y sucursal - Manual",
    "description": "No ejecutar toda esta colección de una vez. Usa el mismo entorno ACME - Local que el recorrido principal. Mantén su guiaReintentos (o pega una guía existente con primer intento fallido). Ejecuta la carpeta 1; el segundo día, la 2; el tercer día, la 3. Solo después de ver en_sucursal, la 4. Las franjas del servidor son mañana 09–13 y tarde 14–18, hora de Ciudad de México. Las fechas no pueden adelantarse desde Postman. Este flujo comparte tokens con la colección principal: úsalo después de terminar aquella.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 - Preparar seguimiento",
      "description": "Verifica guiaReintentos en el entorno. No vuelvas a ejecutar el recorrido principal entre días si deseas conservar esta guía.",
      "item": [
        {
          "name": "Iniciar sesión - administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Autentica al administrador y guarda tokenAdministrador e idAdministrador en el entorno seleccionado.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoAdministrador}}\",\n  \"contrasena\": \"{{contrasenaDemo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset('tokenAdministrador');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const datos = pm.response.json();",
                  "  pm.environment.set('tokenAdministrador', datos.token);",
                  "  pm.environment.set('idAdministrador', datos.usuario.id);",
                  "}",
                  "pm.test('Token y usuario disponibles', function () { pm.expect(pm.response.json().token).to.be.a('string').and.not.empty; });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Iniciar sesión - repartidor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Autentica al repartidor y guarda tokenRepartidor e idRepartidor en el entorno seleccionado.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoRepartidor}}\",\n  \"contrasena\": \"{{contrasenaDemo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset('tokenRepartidor');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const datos = pm.response.json();",
                  "  pm.environment.set('tokenRepartidor', datos.token);",
                  "  pm.environment.set('idRepartidor', datos.usuario.id);",
                  "}",
                  "pm.test('Token y usuario disponibles', function () { pm.expect(pm.response.json().token).to.be.a('string').and.not.empty; });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Consultar estado de la guía que continuará",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/api/v1/tracking/{{guiaReintentos}}",
            "description": "Resultado esperado: HTTP 200."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  ""
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Consultar fecha y franja del próximo intento",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenRepartidor}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/reintentos",
            "description": "Resultado esperado: HTTP 200."
          },
          "event": [
            {
              "listen": "test",
              "script": {
