            },
            "url": "{{baseUrl}}/api/v1/paquetes/{{guiaReintentos}}/caso",
            "description": "Resultado esperado: HTTP 200.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteRespondio\": false,\n  \"notasContacto\": \"El proveedor confirmó que se debe regresar\",\n  \"decisionProveedor\": \"regresar\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Estado: en_sucursal', function () { pm.expect(pm.response.json().estado).to.eql('en_sucursal'); });",
                  "pm.test('Caso cerrado sin simular entrega', function () { pm.expect(pm.response.json().casoCerradoEn).to.be.a('string'); pm.expect(pm.response.json().decisionProveedor).to.eql('regresar'); });"
                ]
              }
            }
          ],
          "response": []
        },
